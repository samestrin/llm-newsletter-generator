{#- The email preview of an approved draft. `content` is HTML built by
    render/email.py, which escapes all text and links only safe_url URLs. -#}
{% extends "shell.html.j2" %}
{% block style %}
  .content h1 { margin: 0 0 4px; font-size: 26px; line-height: 1.2; }
  .content h2 { margin: 24px 0 8px; font-size: 20px; line-height: 1.3; }
  .content p { margin: 0 0 16px; }
  .content ul { margin: 0 0 16px; padding-left: 20px; }
  .content li { margin: 0 0 6px; }
  .content a { color: #1a56db; }
  .content table { border-collapse: collapse; font-size: 12px; margin: 0 0 16px; }
  .content th, .content td { padding: 4px 6px; border-bottom: 1px solid #e5e5e5; text-align: left; vertical-align: top; }
  .content code { font-size: 13px; background-color: #f4f4f4; padding: 1px 4px; }
  .content blockquote { margin: 0 0 16px; padding: 8px 12px; background-color: #fff4e5; border-left: 4px solid #b26a00; }
{% endblock %}
{% block content %}
<div class="content">
{{ content }}
</div>
{% endblock %}
